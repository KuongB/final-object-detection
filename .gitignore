# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Data (submitted separately in the ZIP / Drive link, not in git) ---
data/
!data/.gitkeep

# --- Training artefacts ---
runs/

# Raw COCO detection dumps - ~7 MB each, regenerated by scripts/20_evaluate.py.
# The scored metrics they produce are kept in reports/results/evaluation_*.json.
reports/results/detections_*.json

# Console log of each evaluation run, appended to across runs.
reports/results/evaluate_*.log

# --- Model weights, wherever they land ---
# Not anchored on purpose: ultralytics downloads its checkpoints into whatever
# the current working directory happens to be - the repo root for scripts, and
# notebooks/ when a notebook is executed.
*.pt
*.pth
*.onnx
*.safetensors

# --- Web app runtime ---
# The app keeps uploads and camera frames in memory; only the sample videos
# a demo might drop into webapp/samples/ are worth excluding.
webapp/samples/*.mp4

# --- FiftyOne / Ultralytics local state ---
.fiftyone/
*.mongodb

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
