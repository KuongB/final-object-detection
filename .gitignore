# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Data (submitted separately in the ZIP / Drive link, not in git) ---
# Anchored with a leading slash on purpose: a bare `data/` matches a directory
# of that name at ANY depth, which silently excluded the whole `src/data/`
# package - build.py, coco_dataset.py, transforms.py - from the repository.
# `/data/*` rather than `/data/`: git never descends into an excluded
# directory, so the negation below only works if the directory itself stays
# included. This keeps an empty `data/` in a fresh clone, which is what the
# default paths in src/config.py expect.
/data/*
!/data/.gitkeep

# --- Training artefacts ---
/runs/

# Raw COCO detection dumps - ~7 MB each, regenerated by scripts/20_evaluate.py.
# The scored metrics they produce are kept in reports/results/evaluation_*.json.
reports/results/detections_*.json

# Console log of each evaluation run, appended to across runs.
reports/results/evaluate_*.log

# --- Model weights, wherever they land ---
# Not anchored on purpose: ultralytics downloads its checkpoints into whatever
# the current working directory happens to be - the repo root for scripts, and
# notebooks/ when a notebook is executed.
*.pt
*.pth
*.onnx
*.safetensors

# --- Web app runtime ---
# The app keeps uploads and camera frames in memory; only the sample videos
# a demo might drop into webapp/samples/ are worth excluding.
webapp/samples/*.mp4

# Camera-session records. Written at runtime, one JSON per session plus a
# rolling sessions.csv - other people's runs, not source.
webapp/sessions/

# --- Report bundle ---
# Derived copy of reports/report.md + figures, rebuilt by
# scripts/06_report_bundle.py. The originals under reports/ are the source.
/report-prism/
/report-latex/
/report-latex.zip

# --- FiftyOne / Ultralytics local state ---
.fiftyone/
*.mongodb

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
