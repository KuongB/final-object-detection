# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Data (submitted separately in the ZIP / Drive link, not in git) ---
data/
!data/.gitkeep

# --- Training artefacts ---
runs/

# Raw COCO detection dumps - ~7 MB each, regenerated by scripts/20_evaluate.py.
# The scored metrics they produce are kept in reports/results/evaluation_*.json.
reports/results/detections_*.json
weights/**/*.pt
weights/**/*.pth
weights/**/*.onnx
weights/**/*.safetensors

# Pretrained checkpoints ultralytics downloads into the working directory
# (yolov8m.pt, rtdetr-l.pt). Needed to run, but re-downloaded automatically.
/*.pt

# --- Web app runtime ---
webapp/backend/uploads/
webapp/backend/outputs/
webapp/samples/*.mp4

# --- FiftyOne / Ultralytics local state ---
.fiftyone/
*.mongodb

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
